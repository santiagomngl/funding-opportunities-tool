# Added for this source-export handoff. No required application secrets or API keys.
# All examples below are optional; uncomment only if needed.

# Vinext production startup reads PORT (or use --port).
# PORT=3000

# The Bash install/build wrappers read these from the shell environment.
# Export them in your shell; Bash does not load this file automatically.
# SITES_INSTALL_TIMEOUT=8m
# SITES_INSTALL_KILL_AFTER=15s
# SITES_BUILD_TIMEOUT=3m
# SITES_BUILD_KILL_AFTER=10s

# Optional install-cache seed; leave unset for the normal network install path.
# SITES_NPM_CACHE_SEED=/absolute/path/to/a/compatible/npm-cache
